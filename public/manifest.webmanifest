      "form_factor": "narrow",
      "label": "Your Tempo dashboard on mobile"
    },
    {
      "src": "screenshots/desktop-preview.png",
      "sizes": "1440x1000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tempo on the web"
    }
  ],
  "shortcuts": [
    {
      "name": "Explore places",
