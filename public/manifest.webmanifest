      "url": "./explore?source=pwa-shortcut",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My appointments",
      "short_name": "Bookings",
      "description": "See your upcoming appointments",
      "url": "./account/bookings?source=pwa-shortcut",
      "icons": [
        {
