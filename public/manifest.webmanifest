{
  "id": "./",
  "name": "Tempo — Appointments across Botswana",
  "short_name": "Tempo",
  "description": "Book appointments at Botswana's independent businesses in BWP, at the studio or at home. Message owners and never miss a new opening.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f5f2ea",
  "theme_color": "#202d24",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "lifestyle",
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/mobile-preview.png",
      "sizes": "390x844",
